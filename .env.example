# URL del CSV publicado de la hoja del ranking
# (Google Sheets > Archivo > Compartir > Publicar en la web > CSV)
RANKING_CSV_URL=https://docs.google.com/spreadsheets/d/e/<ID_PUBLICADO>/pub?output=csv

# Inscripciones: URL /exec del Apps Script de la hoja PRIVADA (apps-script/inscripciones.gs)
REGISTRO_SCRIPT_URL=https://script.google.com/macros/s/<ID_IMPLEMENTACION>/exec
# Misma clave que la propiedad SECRETO del Apps Script
REGISTRO_SECRETO=<clave-larga-aleatoria>
